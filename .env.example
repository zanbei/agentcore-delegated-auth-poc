# Copy to .env and fill in. .env is git-ignored.
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-west-2

# Keycloak realm issuer, HTTPS, reachable by AgentCore (not localhost)
KC_ISSUER=https://keycloak.example.com/realms/obo-test

# File with AGENT_SECRET, ALICE_PW, BOB_PW, BG_SECRET (KEY=value per line), kept outside the repo
SECRETS_FILE=~/.agentcore-poc/secrets.env

# PoC 1
GATEWAY_URL=https://<gateway-id>.gateway.bedrock-agentcore.us-west-2.amazonaws.com/mcp

# Only for direct downstream checks over HTTP (optional)
DOWNSTREAM_URL=

# scripts/cleanup.sh
GATEWAY_ID=
TARGET_ID=
CF_ID=
INSTANCE_ID=
SG_ID=
SG_RULE_ID=
